{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行 Code Inspection 扩展",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/tests/fixtures/workspace",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js", "${workspaceFolder}/dist/**/*.cjs"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
