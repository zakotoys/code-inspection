{
  "version": 2,
  "checks": {
    "eslint": {
      "adapter": "eslint",
      "enabled": false,
      "languages": ["javascript", "typescript"],
      "scope": "file",
      "cwd": ".",
      "patterns": ["**/*.js"]
    },
    "typescript": {
      "adapter": "typescript",
      "enabled": false,
      "languages": ["javascript", "typescript"],
      "scope": "project",
      "cwd": ".",
      "project": "tsconfig.json"
    },
    "build": {
      "adapter": "command",
      "enabled": true,
      "languages": [],
      "scope": "workspace",
      "cwd": ".",
      "command": ["node", "-e", "console.error('fixture build failed'); process.exit(4)"],
      "parser": "build",
      "timeoutMs": 10000
    }
  }
}
